import json

# =========================
# CLASS OBJECT
# =========================
class Club:
    def __init__(self, id_club, nama, liga, poin):
        self.id = id_club
        self.nama = nama
        self.liga = liga
        self.poin = poin

    def tampil(self):
        return f"{self.id} | {self.nama} | {self.liga} | {self.poin}"

# =========================
# LINKED LIST
# =========================
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

class LinkedList:
    def __init__(self):
        self.head = None

    def tambah(self, data):
        n = Node(data)
        if not self.head:
            self.head = n
            return
        c = self.head
        while c.next:
            c = c.next
        c.next = n

    def tampil_semua(self):
        r = []
        c = self.head
        while c:
            r.append(c.data)
            c = c.next
        return r

    def hapus(self, idc):
        c = self.head
        p = None
        while c:
            if c.data.id == idc:
                if p:
                    p.next = c.next
                else:
                    self.head = c.next
                return True
            p = c
            c = c.next
        return False

    def update(self, idc, n, l, p):
        c = self.head
        while c:
            if c.data.id == idc:
                c.data.nama = n
                c.data.liga = l
                c.data.poin = p
                return True
            c = c.next
        return False

# =========================
# STACK & QUEUE
# =========================
class Stack:
    def __init__(self):
        self.data = []
    def push(self, x):
        self.data.append(x)
    def tampil(self):
        return self.data

class Queue:
    def __init__(self):
        self.data = []
    def enqueue(self, x):
        self.data.append(x)
    def tampil(self):
        return self.data

# =========================
# GLOBAL
# =========================
club_list = LinkedList()
history_stack = Stack()
watchlist_queue = Queue()

club_dict = {}
liga_set = set()

FILE = "data_club.json"

# =========================
# SAVE LOAD
# =========================
def simpan():
    data = []
    for c in club_list.tampil_semua():
        data.append({
            "id": c.id,
            "nama": c.nama,
            "liga": c.liga,
            "poin": c.poin
        })
    with open(FILE, "w") as f:
        json.dump(data, f)

def load():
    try:
        with open(FILE, "r") as f:
            data = json.load(f)
        for d in data:
            club_list.tambah(Club(d["id"], d["nama"], d["liga"], d["poin"]))
    except:
        pass

# =========================
# VALIDASI INPUT (NEW)
# =========================
def validasi():
    if eid.get() == "" or ena.get() == "" or eli.get() == "" or epo.get() == "":
        messagebox.showwarning("Warning", "Semua field harus diisi!")
        return False

    if not eid.get().isdigit():
        messagebox.showerror("Error", "ID harus angka!")
        return False

    if not epo.get().isdigit():
        messagebox.showerror("Error", "Poin harus angka!")
        return False

    return True

# =========================
# REFRESH TABLE
# =========================
def refresh():
    for i in tree.get_children():
        tree.delete(i)

    for c in club_list.tampil_semua():
        tree.insert("", END, values=(c.id, c.nama, c.liga, c.poin))

# =========================
# CRUD
# =========================
def tambah():
    if not validasi():
        return

    c = Club(int(eid.get()), ena.get(), eli.get(), int(epo.get()))
    club_list.tambah(c)

    club_dict[c.id] = c
    liga_set.add(c.liga)

    simpan()
    refresh()

def update():
    if not validasi():
        return

    club_list.update(int(eid.get()), ena.get(), eli.get(), int(epo.get()))
    simpan()
    refresh()

def hapus():
    if eid.get() == "":
        messagebox.showwarning("Warning", "ID harus diisi!")
        return

    if not eid.get().isdigit():
        messagebox.showerror("Error", "ID harus angka!")
        return

    club_list.hapus(int(eid.get()))
    simpan()
    refresh()

# =========================
# SEARCH & SORT
# =========================
def cari():
    key = ena.get().lower()
    result = [c for c in club_list.tampil_semua() if key in c.nama.lower()]

    for i in tree.get_children():
        tree.delete(i)

    for c in result:
        tree.insert("", END, values=(c.id, c.nama, c.liga, c.poin))

def top3():
    data = sorted(club_list.tampil_semua(), key=lambda x: x.poin, reverse=True)

    for i in tree.get_children():
        tree.delete(i)

    for c in data[:3]:
        tree.insert("", END, values=(c.id, c.nama, c.liga, c.poin))

