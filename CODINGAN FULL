Button(frame, text="Recommend", command=recommend).grid(row=6, column=1)

Button(frame, text="Filter Liga", command=filter_liga).grid(row=7, column=0)
Button(frame, text="Reset", command=reset).grid(row=7, column=1)
Button(frame, text="Clear", command=clear).grid(row=7, column=2)

Button(frame, text="Detail", command=detail).grid(row=8, column=0)
Button(frame, text="Ranking Top 5", command=ranking).grid(row=8, column=1)

Button(frame, text="ToDo", command=todo_add).grid(row=9, column=0)
Button(frame, text="View ToDo", command=todo_view).grid(row=9, column=1)

Button(frame, text="Log", command=log_view).grid(row=9, column=2)


