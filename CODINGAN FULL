        listbox.insert(END, club.tampil())


def tambah_club():

    try:

        id_club = int(entry_id.get())

        nama = entry_nama.get()

        liga = entry_liga.get()

        poin = int(entry_poin.get())

        club = Club(
            id_club,
            nama,
            liga,
            poin
        )

        club_list.tambah(club)

        refresh_data()

    except:

        pass


def update_club():

    try:

        id_club = int(entry_id.get())

        nama = entry_nama.get()

        liga = entry_liga.get()

        poin = int(entry_poin.get())

        club_list.update(
            id_club,
            nama,
            liga,
            poin
        )

        refresh_data()

    except:

        pass


def hapus_club():

    try:

        id_club = int(entry_id.get())

        club_list.hapus(id_club)

        refresh_data()

    except:

        pass


def cari_data():

    keyword = entry_nama.get()

    hasil = cari_club(
        club_list.tampil_semua(),
        keyword
    )

    listbox.delete(0, END)

    for club in hasil:

        listbox.insert(END, club.tampil())


def urutkan_poin():

    data = club_list.tampil_semua()

    hasil = bubble_sort_poin(data)

    listbox.delete(0, END)

    for club in hasil:

        listbox.insert(END, club.tampil())


def tambah_history():

    pertandingan = entry_nama.get()

    history_stack.push(pertandingan)


def lihat_history():

    listbox.delete(0, END)

    for item in history_stack.tampil():

        listbox.insert(END, item)


def tambah_watchlist():

    pertandingan = entry_nama.get()

    watchlist_queue.enqueue(pertandingan)


def lihat_watchlist():

    listbox.delete(0, END)

    for item in watchlist_queue.tampil():

        listbox.insert(END, item)


