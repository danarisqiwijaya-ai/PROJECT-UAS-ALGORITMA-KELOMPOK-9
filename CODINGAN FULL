from tkinter import *
from tkinter import messagebox

class Club:
    def __init__(self, id_club, nama, liga, poin):
        self.id = id_club
        self.nama = nama
        self.liga = liga
        self.poin = poin

    def tampil(self):
        return str(self.id) + " | " + self.nama + " | " + self.liga + " | Poin: " + str(self.poin)


class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


class LinkedList:
    def __init__(self):
        self.head = None

    def cek_id(self, id_club):
        current = self.head
        while current:
            if current.data.id == id_club:
                return True
            current = current.next
        return False

    def tambah(self, data):
        new_node = Node(data)

        if self.head is None:
            self.head = new_node
            return

        current = self.head
        while current.next:
            current = current.next
        current.next = new_node

    def tampil_semua(self):
        hasil = []
        current = self.head

        while current:
            hasil.append(current.data)
            current = current.next

        return hasil

    def hapus(self, id_club):
        current = self.head
        prev = None

        while current:
            if current.data.id == id_club:
                if prev:
                    prev.next = current.next
                else:
                    self.head = current.next
                return True

            prev = current
            current = current.next

        return False

    def update(self, id_club, nama_baru, liga_baru, poin_baru):
        current = self.head

        while current:
            if current.data.id == id_club:
                current.data.nama = nama_baru
                current.data.liga = liga_baru
                current.data.poin = poin_baru
                return True
            current = current.next
        return False


class Stack:
    def __init__(self):
        self.data = []

    def push(self, item):
        self.data.append(item)

    def tampil(self):
        return self.data


class Queue:
    def __init__(self):
        self.data = []

    def enqueue(self, item):
        self.data.append(item)

    def tampil(self):
        return self.data


def cari_club(data, keyword):
    return [c for c in data if keyword.lower() in c.nama.lower()]


def bubble_sort_poin(data, mode="desc"):
    n = len(data)

    for i in range(n):
        for j in range(0, n - i - 1):
            if mode == "desc":
                if data[j].poin < data[j + 1].poin:
                    data[j], data[j + 1] = data[j + 1], data[j]
            else:
                if data[j].poin > data[j + 1].poin:
                    data[j], data[j + 1] = data[j + 1], data[j]

    return data


def binary_search(data, key):
    data = sorted(data, key=lambda x: x.nama.lower())
    l, r = 0, len(data) - 1

    while l <= r:
        m = (l + r) // 2

        if key.lower() in data[m].nama.lower():
            return data[m]
        elif key.lower() < data[m].nama.lower():
            r = m - 1
        else:
            l = m + 1

    return None


club_list = LinkedList()
history_stack = Stack()
watchlist_queue = Queue()

root = Tk()
root.title("Football Recommendation System")
root.geometry("980x720")
root.configure(bg="#101820")


def clear_input():
    entry_id.delete(0, END)
    entry_nama.delete(0, END)
    entry_liga.delete(0, END)
    entry_poin.delete(0, END)


def refresh_data():
    listbox.delete(0, END)
    for club in club_list.tampil_semua():
        listbox.insert(END, club.tampil())


def validasi_input():
    if entry_id.get() == "" or entry_nama.get() == "" or entry_liga.get() == "" or entry_poin.get() == "":
        messagebox.showerror("Error", "Input tidak boleh kosong")
        return False

    try:
        int(entry_id.get())
        int(entry_poin.get())
    except:
        messagebox.showerror("Error", "ID dan Poin harus angka")
        return False

    return True


def tambah_club():
    if not validasi_input():
        return

    id_club = int(entry_id.get())

    if club_list.cek_id(id_club):
        messagebox.showwarning("Warning", "ID sudah ada")
        return

    club = Club(id_club, entry_nama.get(), entry_liga.get(), int(entry_poin.get()))
    club_list.tambah(club)

    messagebox.showinfo("Sukses", "Club berhasil ditambahkan")
    refresh_data()
    clear_input()


def update_club():
    if not validasi_input():
        return

    club_list.update(
        int(entry_id.get()),
        entry_nama.get(),
        entry_liga.get(),
        int(entry_poin.get())
    )

    messagebox.showinfo("Sukses", "Data berhasil diupdate")
    refresh_data()


def hapus_club():
    club_list.hapus(int(entry_id.get()))
    messagebox.showinfo("Sukses", "Data dihapus")
    refresh_data()


def top3():
    data = bubble_sort_poin(club_list.tampil_semua(), "desc")[:3]

    listbox.delete(0, END)
    listbox.insert(END, "=== TOP 3 CLUB ===")

    for c in data:
        listbox.insert(END, c.tampil())


def statistik():
    data = club_list.tampil_semua()

    liga_count = {}

    for c in data:
        liga_count[c.liga] = liga_count.get(c.liga, 0) + 1

    listbox.delete(0, END)
    listbox.insert(END, "=== STATISTIK LIGA ===")

    for k, v in liga_count.items():
        listbox.insert(END, f"{k} : {v} club")


def cari_data():
    hasil = cari_club(club_list.tampil_semua(), entry_nama.get())

    listbox.delete(0, END)

    for c in hasil:
        listbox.insert(END, c.tampil())


def lihat_history():
    listbox.delete(0, END)
    for i in history_stack.tampil():
        listbox.insert(END, i)


def lihat_watchlist():
    listbox.delete(0, END)
    for i in watchlist_queue.tampil():
        listbox.insert(END, i)


